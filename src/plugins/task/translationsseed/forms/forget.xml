<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<field
				name="target_language"
				type="language"
				label="PLG_TASK_TRANSLATIONSSEED_FORGET_LANGUAGE_LABEL"
				description="PLG_TASK_TRANSLATIONSSEED_FORGET_LANGUAGE_DESC"
				required="true"
			/>
			<field
				name="include_published"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="PLG_TASK_TRANSLATIONSSEED_FORGET_INCLUDE_PUBLISHED_LABEL"
				description="PLG_TASK_TRANSLATIONSSEED_FORGET_INCLUDE_PUBLISHED_DESC"
				default="0"
				filter="integer"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="include_published_warning"
				type="note"
				class="alert alert-warning"
				description="PLG_TASK_TRANSLATIONSSEED_FORGET_INCLUDE_PUBLISHED_WARNING"
				showon="include_published:1"
			/>
		</fieldset>
	</fields>
</form>
